<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nút chữ chuẩn (56dp) dùng cho hàng Volume/Media -->
    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@color/key_default</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Nút icon chuẩn (56dp, chữ/icon lớn hơn, dùng cho hàng Media) -->
    <style name="RemoteKeyIcon" parent="RemoteKey">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Nút CHỈ CÓ ICON (không chữ): textSize PHẢI = 0sp, vì MaterialButton tính vị
         trí icon dựa trên khoảng trống chữ "ảo" theo textSize dù chữ rỗng — để
         textSize khác 0 làm icon bị đẩy lệch tâm (bug đã gặp ở nút mic/bàn phím). -->
    <style name="RemoteKeyIconOnly" parent="RemoteKey">
        <item name="android:textSize">0sp</item>
    </style>

    <!-- Nút cho hàng điều hướng — chiều cao theo parent (match_parent) -->
    <style name="RemoteKeyTall" parent="RemoteKey">
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="RemoteKeyIconTall" parent="RemoteKeyTall">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Bản CHỈ CÓ ICON của RemoteKeyIconTall — xem giải thích ở RemoteKeyIconOnly. -->
    <style name="RemoteKeyIconOnlyTall" parent="RemoteKeyTall">
        <item name="android:textSize">0sp</item>
    </style>

</resources>
