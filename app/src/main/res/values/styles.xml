<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nút chữ chuẩn (56dp) dùng cho hàng Volume/Media -->
    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@color/key_default</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Nút icon chuẩn (56dp, chữ/icon lớn hơn, dùng cho hàng Media) -->
    <style name="RemoteKeyIcon" parent="RemoteKey">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Nút cao hơn (68dp) dùng riêng cho hàng điều hướng trên cùng, đủ chỗ
         cho nút "Thiết bị" xuống 2 dòng mà vẫn canh giữa đẹp -->
    <style name="RemoteKeyTall" parent="RemoteKey">
        <item name="android:layout_height">68dp</item>
    </style>

    <style name="RemoteKeyIconTall" parent="RemoteKeyTall">
        <item name="android:textSize">22sp</item>
    </style>

</resources>
