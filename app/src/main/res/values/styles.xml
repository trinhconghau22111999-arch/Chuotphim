<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Style dùng chung cho các phím điều khiển (Volume / Power / Media...) để
         cả hàng luôn cùng kích cỡ, cùng chiều cao, cùng bo góc, canh lề đều
         nhau. Chiều cao 43dp (= 90% của 48dp gốc) đồng bộ với controlsRow
         (Thiết bị/Home/Back/bàn phím) ở style RemoteKeyButtonTall bên dưới —
         toàn bộ các hàng phím trong app giờ cùng 1 chiều cao 43dp, không
         hàng nào cao/thấp hơn hàng nào.
         LƯU Ý: TRƯỚC ĐÂY dùng android:autoSizeTextType="uniform" để chữ tự thu
         nhỏ vừa 1 dòng — nhưng thuộc tính này khi kết hợp với MaterialButton có
         1 lỗi hiển thị đã biết: nền nút bị co lại từ CẠNH TRÊN vài px so với
         nút thường (không autosize), khiến hàng nút có autosize trông THẤP hơn
         hẳn hàng nút icon dù cùng khai báo layout_height hệt nhau. Đã bỏ hẳn
         autoSizeText, thay bằng 1 cỡ chữ CỐ ĐỊNH (16sp) + giữ maxLines=1/
         ellipsize để nếu máy nào quá hẹp thì chữ tự cắt bớt "..." thay vì tự
         thu nhỏ (an toàn hơn, không còn gây lệch chiều cao nút).
         ĐƠN VỊ dp THAY VÌ sp: cỡ chữ dùng "dp" (không phải "sp") CHỦ Ý — sp co
         giãn theo cài đặt "Cỡ chữ hiển thị" của hệ thống, nên nếu người dùng đặt
         cỡ chữ máy lớn hơn 100%, chữ trên nút cũng phóng to theo và dễ bị
         ellipsize cắt (vd "Home" -> "Ho..."). Dùng dp giữ cỡ chữ LUÔN CỐ ĐỊNH,
         không phụ thuộc cài đặt accessibility của máy, đảm bảo chữ trên phím
         luôn hiện đủ. Đánh đổi: người dùng đặt cỡ chữ hệ thống to hơn để dễ đọc
         sẽ không ảnh hưởng tới chữ trên các phím remote này. -->
    <style name="RemoteKeyButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">39dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <!-- BẮT BUỘC: Widget.Material3.Button mặc định có minHeight ~48dp
             (chuẩn touch-target accessibility). Nếu không tắt, Material3 vẫn
             cố vẽ nền nút theo khung 48dp ảo rồi mới bị ép cắt xuống đúng
             layout_height=39dp thật -> phần bo góc DƯỚI của nút bị hụt/cắt
             cụt so với góc TRÊN (đã xác nhận bằng đo pixel: góc trên bo đủ,
             góc dưới bo dở dang rồi bị cắt). Trước đây chỉ btnPickDevice (⇄)
             được tự set minHeight/minWidth=0dp riêng ở layout nên không bị,
             mọi nút khác (Home/Back/⌨/OFF/Vol−/Vol+/mic/media...) đều bị.
             Set ở đây (style gốc) để áp dụng cho TẤT CẢ nút cùng lúc. -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">13dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">14dp</item>
        <!-- Canh giữa chữ/icon TRONG style gốc thay vì để từng nút tự khai
             báo riêng lẻ — trước đây chỉ Thiết bị/Home/mic/bàn phím có
             android:gravity="center" ở layout, còn Back/OFF/Vol−/Vol+ và cả
             5 nút Media (Rewind/Previous/PlayPause/Next/FastForward) THIẾU
             thuộc tính này, khiến chữ/icon của các nút đó bị lệch không
             đồng đều (khi sát cạnh trên, khi tuột xuống dưới) tuỳ máy/font
             render — đây là nguyên nhân THẬT của lỗi, không liên quan gì
             đến khoảng cách paddingTop/Bottom giữa các hàng. Đặt ở style gốc
             để MỌI nút dùng RemoteKeyButton/Tall/IconButton/IconButtonTall
             đều tự động canh giữa, không còn phụ thuộc việc từng nút có nhớ
             khai báo gravity hay không. -->
        <item name="android:gravity">center</item>
        <!-- Nền xám thay vì tím mặc định của theme Material3 (colorPrimary
             chưa override nên trước đây rơi về tím #6750A4 mặc định). Các nút
             cần màu riêng (OFF đỏ...) vẫn override backgroundTint tại chỗ,
             ghi đè lên giá trị này bình thường. -->
        <item name="android:backgroundTint">#00000000</item>
        <item name="strokeColor">#4CAF50</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Style cho phím CHỈ CÓ 1 KÝ TỰ ICON (⏮ ⏯ ⏭ « »...): kế thừa mọi
         thuộc tính kích cỡ/bo góc từ RemoteKeyButton (cùng layout_height=43dp
         nên chiều cao luôn khớp các nút chữ trong cùng hàng/hàng khác) nhưng
         dùng cỡ chữ 20sp lớn hơn cho phù hợp icon. -->
    <style name="RemoteKeyIconButton" parent="RemoteKeyButton">
        <item name="android:textSize">18dp</item>
    </style>

    <!-- controlsRow (Thiết bị / Home / Back / bàn phím) dùng riêng 2 style Tall
         này — về mặt chiều cao hiện đã bằng RemoteKeyButton/RemoteKeyIconButton
         (đều 43dp) nên không còn khác biệt về kích cỡ; giữ tên style Tall
         riêng để không phải sửa lại các android:id tham chiếu trong layout,
         và để dễ tách riêng chỉnh sau này nếu cần mà không ảnh hưởng hàng
         khác. -->
    <style name="RemoteKeyButtonTall" parent="RemoteKeyButton">
        <item name="android:layout_height">39dp</item>
    </style>

    <style name="RemoteKeyIconButtonTall" parent="RemoteKeyIconButton">
        <item name="android:layout_height">39dp</item>
        <item name="android:textSize">13dp</item>
    </style>
</resources>
