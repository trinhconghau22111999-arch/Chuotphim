<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#212121"
        android:textColor="#FFFFFF"
        android:text="Chưa đăng ký HID" />

    <!-- Nửa trên: TRACKPAD -->
    <com.example.btremote.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444" />

    <!-- Nửa dưới: BÀN PHÍM + điều khiển kết nối -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1B1B1B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Đăng ký làm bàn phím + chuột Bluetooth" />

            <Button
                android:id="@+id/btnPickDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. Chọn thiết bị đã pair để kết nối" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#888888"
                android:text="(Nếu chưa pair: vào Cài đặt Bluetooth của máy này, pair với TV/PC trước, rồi quay lại bấm nút 2)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/keyHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Home" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenKeyboard"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:text="⌨"
                    android:textSize="22sp"
                    android:contentDescription="Mở bàn phím để gõ chữ" />

            </LinearLayout>

            <EditText
                android:id="@+id/hiddenInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:importantForAutofill="no"
                android:inputType="text" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="1">

                <Button android:id="@+id/keyBackspace" style="@style/KeyBtn" android:text="⌫" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
