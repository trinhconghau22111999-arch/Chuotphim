<?xml version="1.0" encoding="utf-8"?>
<!--
    Root là FrameLayout để chứa 2 lớp:
      - mainColumn: cột nội dung chính (trạng thái / trackpad / các hàng nút /
        thanh nhập liệu đồng bộ), thứ tự và sự có mặt của từng phần được
        MainActivity tự sắp xếp lại tuỳ theo bàn phím ảo đang ẩn hay hiện,
        xem applyLayoutState() trong code.
      - syncInput (bên trong syncInputBar): ô nhập liệu THẬT dùng để hứng bàn
        phím ảo hệ thống — chỉ được add vào mainColumn khi bàn phím đang mở,
        luôn nằm CUỐI mainColumn nên hiện ngay phía trên bàn phím ảo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- topBar: khi CHƯA đăng ký HID thì ẩn statusText, hiện nút đăng ký để
             người dùng bấm; khi ĐÃ đăng ký thì đảo lại — chỉ 1 trong 2 hiện tại
             1 thời điểm (xem MainActivity: setHidRegisteredUi()). -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#212121">

            <!-- paddingStart/End = 56dp: chừa đúng chỗ cho 2 nút tròn nổi 44dp
                 (btnMouseFullscreen / btnKeyboardFullscreen, layout_margin=8dp)
                 luôn nằm đè lên góc trên của FrameLayout gốc, để nội dung
                 không bị 2 nút đó che mất chữ. -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:textColor="#FFFFFF"
                android:text="Chưa đăng ký HID"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterHid"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAllCaps="false"
                android:textColor="#F44336"
                android:text="Đăng ký làm bàn phím và chuột" />

        </FrameLayout>

        <!-- Trackpad: chiếm hết phần còn lại, diện tích tự co giãn theo
             vị trí của 3 phím và chiều cao bàn phím ảo. -->
        <com.example.btremote.TrackpadView
            android:id="@+id/trackpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444" />

        <!-- LƯU Ý: controlsRow/volumeControls/mediaControls PHẢI là con
             TRỰC TIẾP của mainColumn — MainActivity.applyLayoutState() gọi
             mainColumn.removeAllViews() rồi mainColumn.addView(controlsRow),
             addView(volumeControls), addView(mediaControls) thẳng mỗi khi
             bàn phím ảo ẩn/hiện. Từng bọc 3 hàng này vào 1 LinearLayout cha
             (keyRowsContainer) để "gộp 1 nền" nhưng làm addView() ném
             IllegalStateException (view đã có cha khác) -> app văng ngay khi
             bấm nút mở bàn phím. Quay lại cấu trúc phẳng, dùng CHUNG 1 màu
             nền (key_rows_background) khai báo riêng ở mỗi hàng thay vì gộp
             view — vẫn nhìn liền mạch vì 3 hàng cùng màu, không còn crash. -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/key_rows_background"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
>

            <!-- Nút Thiết bị: đổi từ chữ "Thiết bị" sang icon 2 mũi tên ngược
                 chiều (⇄, U+21C4) — quy ước phổ biến cho "chuyển đổi/chọn
                 thiết bị". Bỏ maxLines=2/ellipsize/textSize=9sp vì không còn
                 cần chỗ cho chữ dài xuống 2 dòng, dùng chung cỡ chữ 20sp như
                 các nút icon khác trong app. -->
            <!-- Nút Thiết bị (⇄): override riêng padding/minSize/textSize thay vì
                 dùng nguyên style RemoteKeyIconButtonTall (13sp) — Material3
                 Button mặc định có paddingTop/Bottom + minWidth/minHeight khá lớn,
                 chiếm hết chỗ khiến icon không lớn được dù nút cao 39dp. Đặt hết
                 các padding/min về 0 để icon chiếm tối đa chiều cao hàng, cỡ chữ
                 26sp là mức lớn nhất còn nằm gọn trong 39dp (không bị cắt trên/dưới). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDevice"
                style="@style/RemoteKeyIconButtonTall"
                android:gravity="center"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:textSize="14dp"
                android:text="⇄"
                android:contentDescription="Chọn thiết bị" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyHome"
                style="@style/RemoteKeyButtonTall"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14dp"
                android:text="Home" />

            <!-- Back: chuyển từ hàng volumeControls lên đây, đứng cùng nhóm điều
                 hướng với Thiết bị/Home thay vì nằm lẫn trong nhóm Volume. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/RemoteKeyButtonTall"
                android:text="Back"
                android:textSize="14dp"
                android:contentDescription="Quay lại (phím Escape — hầu hết TV nhận là nút Back)" />

            <!-- Nút bàn phím: viết lại từ đầu, đơn giản, đồng bộ cách làm
                 với Thiết bị/Home ở trên — không còn dựa vào comment/hack cũ. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenKeyboard"
                style="@style/RemoteKeyIconButtonTall"
                android:gravity="center"
                android:text=""
                app:icon="@drawable/ic_keyboard"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                android:textSize="14dp"
                android:contentDescription="Mở bàn phím để gõ chữ" />

        </LinearLayout>

        <!-- Hàng nút Volume: đặt cố định ngay dưới 3 phím điều khiển, cùng style
             RemoteKeyButton để đồng bộ kích cỡ/bo góc với hàng phía trên.
             paddingTop=3dp giống controlsRow -> khối 3 hàng icon (controlsRow/
             volumeControls/mediaControls) có khoảng cách đều nhau, gọn gàng.
             không hàng nào bị lệch cao/thấp hơn hàng khác. -->
        <LinearLayout
            android:id="@+id/volumeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:background="@color/key_rows_background"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenOff"
                style="@style/RemoteKeyButton"
                android:text="OFF"
                android:textSize="14dp"
                android:contentDescription="Tắt màn hình (chỉ áp dụng cho TV)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeDown"
                style="@style/RemoteKeyButton"
                android:text="Vol −"
                android:textSize="14dp"
                android:contentDescription="Giảm âm lượng" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeUp"
                style="@style/RemoteKeyButton"
                android:text="Vol +"
                android:textSize="14dp"
                android:contentDescription="Tăng âm lượng" />

            <!-- Mic: chuyển từ hàng controlsRow xuống đây, thay chỗ Back cũ.
                 Dùng icon vector (ic_mic, trắng xám) thay cho emoji "🎤" vì emoji
                 có màu cố định của hệ thống, không tô lại được — nền đen đặt cố
                 định ở đây, code (updateVoiceButtonVisualState) chỉ đổi sang đỏ
                 khi đang nghe, các lúc khác luôn giữ nguyên màu đen này. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceInput"
                style="@style/RemoteKeyIconButton"
                android:gravity="center"
                android:text=""
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                android:contentDescription="Nhập liệu bằng giọng nói" />

        </LinearLayout>

        <!-- Hàng 5 phím điều khiển media, sắp đối xứng quanh nút Play theo đúng
             convention remote: «« Rewind, ⏮ Previous, ⏯ Play/Pause, ⏭ Next,
             »» Fast Forward. Đặt cố định ngay dưới hàng Volume,
             dùng RemoteKeyIconButton (cỡ chữ cố định) thay vì RemoteKeyButton để
             icon không bị auto-size thu nhỏ hơn do hàng này có 5 nút (hẹp hơn 2
             hàng trên chỉ có 4 nút) — đảm bảo icon cùng cỡ với hàng controlsRow.
             paddingTop=3dp, đồng bộ với 2 hàng trên. -->
        <LinearLayout
            android:id="@+id/mediaControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:background="@color/key_rows_background"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Đã thử "◀◀"/"▶▶" (2 ký tự) rồi ⏪/⏩ (1 ký tự emoji) nhưng cả 2
                 đều bị ellipsize cắt thành "..." trên máy test — font/emoji
                 renderer của máy này vẽ các ký tự đó rộng hơn bình thường nên
                 vẫn tràn. Đổi hẳn sang « » (dấu ngoặc kép Pháp, KHÔNG PHẢI
                 emoji — là ký tự văn bản thường U+00AB/U+00BB, luôn có sẵn
                 trong MỌI font hệ thống vì thuộc bảng Latin-1) — quy ước lâu
                 đời trong đầu đĩa/máy nghe nhạc cho tua lùi/tua tới, chắc chắn
                 không bao giờ bị lỗi font hay bị cắt vì rất hẹp. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRewind"
                style="@style/RemoteKeyIconButton"
                android:text="«"
                android:contentDescription="Tua lùi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousTrack"
                style="@style/RemoteKeyIconButton"
                android:text="⏮"
                android:contentDescription="Bài trước" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/RemoteKeyIconButton"
                android:text="⏯"
                android:contentDescription="Play/Pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextTrack"
                style="@style/RemoteKeyIconButton"
                android:text="⏭"
                android:contentDescription="Bài tiếp theo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFastForward"
                style="@style/RemoteKeyIconButton"
                android:text="»"
                android:contentDescription="Tua tới" />

        </LinearLayout>

    </LinearLayout>


    <!-- Thanh nhập liệu nổi: chỉ thêm vào (bằng code, MainActivity) khi bàn phím
         ảo hệ thống đang mở, luôn ở vị trí NGAY TRÊN bàn phím (nhờ mainColumn
         tự co lại do windowSoftInputMode="adjustResize" + đây là view cuối cùng).
         Hiển thị đúng những gì app ĐÃ gửi lên TV (không lấy được nội dung thật
         trên TV vì HID không có chiều nhận ngược) — coi như "bản nháp đồng bộ".
         Gõ trực tiếp vào đây hoặc dán (paste) văn bản có dấu từ điện thoại đều
         được gửi lên TV ngay (tự chuyển Telex nếu cần). Tự xoá trắng khi
         di chuột/bấm chuột hoặc bấm Home, vì lúc đó ô nhập trên TV coi như
         đã đổi/mất focus, không còn đồng bộ với những gì hiển thị ở đây nữa. -->
    <LinearLayout
        android:id="@+id/syncInputBar"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2A2A2A"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/syncInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:gravity="top|start"
            android:background="@android:color/transparent"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="16sp"
            android:hint="Đang gõ trên TV — có thể dán văn bản có dấu vào đây"
            android:inputType="text"
            android:importantForAutofill="no"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasteClipboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_paste"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            android:backgroundTint="#40FFFFFF"
            android:text=""
            android:contentDescription="Dán văn bản từ điện thoại" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearSyncInput"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_clear"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            android:backgroundTint="#40FFFFFF"
            android:text=""
            android:contentDescription="Xoá ô nhập (không xoá chữ đã gửi trên TV)" />

    </LinearLayout>

    <!-- Nút nổi góc trên trái: bật/tắt DUY NHẤT chế độ "chuột toàn màn hình xoay ngang"
         (không liên quan tới bàn phím). Luôn nổi trên mọi lớp nên bấm tắt được ngay
         cả khi 3 phím điều hướng + thanh trạng thái đang bị ẩn tạm.
         Dùng app:icon (vector ic_mouse) thay vì android:text — đã thử cả emoji
         "🖱" lẫn chữ thường "M" nhưng nút hình tròn (cornerRadius=22dp = đúng
         nửa 44dp) tự clip nội dung theo viền tròn, chữ/emoji hình vuông dễ bị
         cắt mất ở góc nên nút hiện trống. Icon vector vẽ sẵn nhỏ hơn (20dp) thì
         luôn nằm gọn trong vòng tròn. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMouseFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:gravity="center"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_mouse"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        android:backgroundTint="#40000000"
        android:text=""
        android:contentDescription="Nhấn đúp để bật/tắt chế độ xoay ngang, phóng to chuột toàn màn hình" />

    <!-- Nút nổi góc trên phải: bật/tắt chế độ "bàn phím toàn màn hình xoay ngang"
         (không cần chuột). Cùng cách sửa như trên, dùng ic_keyboard. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeyboardFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:gravity="center"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_keyboard"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        android:backgroundTint="#40000000"
        android:text=""
        android:contentDescription="Nhấn đúp để bật/tắt chế độ xoay ngang, bàn phím toàn màn hình" />

</FrameLayout>
