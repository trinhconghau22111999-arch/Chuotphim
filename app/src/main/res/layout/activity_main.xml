<?xml version="1.0" encoding="utf-8"?>
<!--
    Root: FrameLayout với 2 lớp:
      - mainColumn: nội dung chính (trạng thái / trackpad / 3 hàng nút / thanh
        gõ đồng bộ), thứ tự các view con do MainActivity.applyLayoutState()
        tự dựng lại tuỳ chế độ hiện tại (bình thường / chuột toàn màn hình /
        bàn phím toàn màn hình).
      - 2 nút tròn nổi góc trên: luôn nằm trên mọi lớp để bấm được bất cứ lúc nào.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_root">

        <!-- minHeight=60dp: 2 nút tròn nổi góc trên (btnMouseFullscreen/btnKeyboardFullscreen,
             44dp + margin 8dp mỗi bên = 60dp) được đặt NGOÀI FrameLayout này (xem cuối file) nên
             tự thân topBar không "biết" chúng cao bao nhiêu - trước đây topBar chỉ cao đúng bằng
             nội dung statusText bên trong (wrap_content), THẤP HƠN 60dp, khiến 2 icon bị lòi hẳn
             ra dưới đáy thanh xám thay vì nằm gọn trong đó. Đặt minHeight khớp đúng 60dp để thanh
             xám luôn bao trọn cả 2 icon dù statusText đang hiện hay ẩn. -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@color/bg_top_bar">

            <!-- padding 56dp 2 bên: chừa chỗ cho 2 nút tròn nổi (44dp + margin 8dp).
                 gravity="center": canh GIỮA chữ theo chiều NGANG trong TextView.
                 layout_gravity="center_vertical": canh GIỮA cả TextView theo chiều DỌC trong
                 topBar (topBar giờ cao 60dp - xem minHeight ở trên - trong khi statusText vẫn
                 wrap_content nên tự nó thấp hơn 60dp; thiếu layout_gravity này thì TextView bị
                 dạt lên sát mép TRÊN của topBar thay vì nằm giữa). -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:textColor="@color/key_danger"
                android:text="Chưa kết nối. Cần đủ 2 điều kiện: (1) điện thoại và TV/Laptop CHƯA từng ghép nối/lưu thiết bị với nhau trước đó, (2) phải dò và kết nối TỪ PHÍA TV/Laptop (không kết nối được bằng cách bấm từ điện thoại)."
                android:visibility="gone" />

            <!-- ĐÃ XOÁ HẲN: nút "btnRegisterHid" từng nằm ở đây - KHÔNG hề được
                 MainActivity.kt gọi tới (không findViewById, không set listener nào cả), luôn
                 hiện tĩnh vô điều kiện nên đè chồng lên statusText phía trên mỗi khi statusText
                 cũng đang hiện - đúng như ảnh chụp màn hình cho thấy: chữ "Chưa kết nối" và nút
                 "Đăng ký làm bàn phím và chuột" chồng lên nhau. Nút ĐĂNG KÝ THẬT SỰ hoạt động là
                 "btnRegisterHidOverlay" (trong khối overlayUnregistered riêng, che toàn màn hình
                 khi CHƯA đăng ký HID) - nút này vẫn giữ nguyên, không bị ảnh hưởng gì bởi việc
                 xoá nút rác ở trên. -->

        </FrameLayout>

        <com.example.btremote.TrackpadView
            android:id="@+id/trackpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_divider" />

        <!-- Hàng điều hướng: Thiết bị / Home / Back / Bàn phím -->
        <LinearLayout
            android:id="@+id/rowNav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/bg_row"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDevice"
                style="@style/RemoteKeyIconOnlyTall"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text=""
                app:icon="@drawable/ic_settings_gear"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                android:backgroundTint="@color/key_teal"
                app:iconTint="@color/icon_on_teal"
                android:contentDescription="Chọn thiết bị" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/RemoteKeyTall"
                android:layout_height="match_parent"
                android:text="Home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/RemoteKeyTall"
                android:layout_height="match_parent"
                android:text="Back"
                android:contentDescription="Quay lại (gửi phím Esc)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenKeyboard"
                style="@style/RemoteKeyIconOnlyTall"
                android:layout_height="match_parent"
                android:text=""
                app:icon="@drawable/ic_keyboard"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                android:backgroundTint="@color/key_teal"
                app:iconTint="@color/icon_on_teal"
                android:contentDescription="Mở bàn phím để gõ chữ" />

        </LinearLayout>

        <!-- Hàng nguồn/âm lượng: OFF / Vol- / Vol+ / Mic -->
        <LinearLayout
            android:id="@+id/rowVolume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:background="@color/bg_row"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenOff"
                style="@style/RemoteKey"
                android:layout_height="match_parent"
                android:text="OFF"
                android:backgroundTint="@color/key_danger"
                android:contentDescription="Tắt màn hình (chỉ áp dụng cho TV)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeDown"
                style="@style/RemoteKey"
                android:layout_height="match_parent"
                android:text="Vol −" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeUp"
                style="@style/RemoteKey"
                android:layout_height="match_parent"
                android:text="Vol +" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceInput"
                style="@style/RemoteKeyIconOnly"
                android:layout_height="match_parent"
                android:text=""
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_primary"
                android:contentDescription="Nhập liệu bằng giọng nói" />

        </LinearLayout>

        <!-- Hàng D-pad: Lên / Xuống / Trái / Phải — như phím cứng điều hướng trên remote thật -->
        <LinearLayout
            android:id="@+id/rowDpad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:background="@color/bg_row"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDpadUp"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="▲"
                android:contentDescription="Lên" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDpadDown"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="▼"
                android:contentDescription="Xuống" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDpadOk"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="OK"
                android:textSize="14sp"
                android:maxLines="1"
                android:contentDescription="Chọn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDpadLeft"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="◀"
                android:contentDescription="Trái" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDpadRight"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="▶"
                android:contentDescription="Phải" />

        </LinearLayout>

        <!-- Hàng media: Rewind / Previous / Play-Pause / Next / Fast forward -->
        <LinearLayout
            android:id="@+id/rowMedia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:background="@color/bg_row"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRewind"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="«"
                android:contentDescription="Tua lùi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousTrack"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="⏮"
                android:contentDescription="Bài trước" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="⏯"
                android:contentDescription="Play/Pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextTrack"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="⏭"
                android:contentDescription="Bài tiếp theo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFastForward"
                style="@style/RemoteKeyIcon"
                android:layout_height="match_parent"
                android:text="»"
                android:contentDescription="Tua tới" />

        </LinearLayout>

    </LinearLayout>

    <!-- Overlay xám phủ toàn màn hình khi chưa đăng ký HID -->
    <FrameLayout
        android:id="@+id/overlayUnregistered"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa đăng ký làm bàn phím và chuột"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterHidOverlay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#F44336"
                android:text="Đăng ký làm bàn phím và chuột"
                app:strokeColor="#F44336"
                app:strokeWidth="2dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Nút tròn nổi góc trên trái: bật/tắt chế độ chuột toàn màn hình (nhấn đúp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMouseFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textSize="0sp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_mouse"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="@color/text_primary"
        android:backgroundTint="#40000000"
        android:text=""
        android:contentDescription="Nhấn đúp để bật/tắt chuột toàn màn hình" />

    <!-- Nút tròn nổi góc trên phải: bật/tắt chế độ bàn phím toàn màn hình (nhấn đúp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeyboardFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textSize="0sp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_keyboard"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="@color/text_primary"
        android:backgroundTint="#40000000"
        android:text=""
        android:contentDescription="Nhấn đúp để bật/tắt bàn phím toàn màn hình" />

</FrameLayout>
