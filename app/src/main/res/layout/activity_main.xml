<?xml version="1.0" encoding="utf-8"?>
<!--
    Root là FrameLayout để chứa 2 lớp:
      - mainColumn: cột nội dung chính (trạng thái / trackpad / các hàng nút /
        thanh nhập liệu đồng bộ), thứ tự và sự có mặt của từng phần được
        MainActivity tự sắp xếp lại tuỳ theo bàn phím ảo đang ẩn hay hiện,
        xem applyLayoutState() trong code.
      - syncInput (bên trong syncInputBar): ô nhập liệu THẬT dùng để hứng bàn
        phím ảo hệ thống — chỉ được add vào mainColumn khi bàn phím đang mở,
        luôn nằm CUỐI mainColumn nên hiện ngay phía trên bàn phím ảo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- topBar: khi CHƯA đăng ký HID thì ẩn statusText, hiện nút đăng ký để
             người dùng bấm; khi ĐÃ đăng ký thì đảo lại — chỉ 1 trong 2 hiện tại
             1 thời điểm (xem MainActivity: setHidRegisteredUi()). -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#212121">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:text="Chưa đăng ký HID"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterHid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAllCaps="false"
                android:text="Đăng ký làm bàn phím và chuột" />

        </FrameLayout>

        <!-- Trackpad: chiếm hết phần còn lại, diện tích tự co giãn theo
             vị trí của 3 phím và chiều cao bàn phím ảo. -->
        <com.example.btremote.TrackpadView
            android:id="@+id/trackpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444" />

        <!-- 3 phím điều khiển: cùng 1 style RemoteKeyButton => cùng kích cỡ,
             cùng chiều cao, canh lề đều nhau. -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1B1B1B"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDevice"
                style="@style/RemoteKeyButton"
                android:text="Chọn thiết bị" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyHome"
                style="@style/RemoteKeyButton"
                android:text="Home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenKeyboard"
                style="@style/RemoteKeyButton"
                android:text="⌨"
                android:textSize="22sp"
                android:contentDescription="Mở bàn phím để gõ chữ" />

        </LinearLayout>

        <!-- Hàng nút Volume: đặt cố định ngay dưới 3 phím điều khiển, cùng style
             RemoteKeyButton để đồng bộ kích cỡ/bo góc với hàng phía trên. -->
        <LinearLayout
            android:id="@+id/volumeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1B1B1B"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenOff"
                style="@style/RemoteKeyButton"
                android:text="⏻"
                android:textSize="22sp"
                android:contentDescription="Tắt màn hình (chỉ áp dụng cho TV)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeDown"
                style="@style/RemoteKeyButton"
                android:text="−"
                android:textSize="22sp"
                android:contentDescription="Giảm âm lượng" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolumeUp"
                style="@style/RemoteKeyButton"
                android:text="+"
                android:textSize="22sp"
                android:contentDescription="Tăng âm lượng" />

        </LinearLayout>

        <!-- Hàng 4 phím điều khiển media: |◄ Previous, ►| Next, ◄◄ Rewind, ►► Fast Forward.
             Đặt cố định ngay dưới hàng Volume, cùng style RemoteKeyButton. -->
        <LinearLayout
            android:id="@+id/mediaControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1B1B1B"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousTrack"
                style="@style/RemoteKeyButton"
                android:text="⏮"
                android:textSize="20sp"
                android:contentDescription="Bài trước" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextTrack"
                style="@style/RemoteKeyButton"
                android:text="⏭"
                android:textSize="20sp"
                android:contentDescription="Bài tiếp theo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRewind"
                style="@style/RemoteKeyButton"
                android:text="⏪"
                android:textSize="20sp"
                android:contentDescription="Tua lùi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFastForward"
                style="@style/RemoteKeyButton"
                android:text="⏩"
                android:textSize="20sp"
                android:contentDescription="Tua tới" />

        </LinearLayout>

        <!-- Thanh nhập liệu nổi: chỉ thêm vào (bằng code, MainActivity) khi bàn phím
             ảo hệ thống đang mở, luôn ở vị trí NGAY TRÊN bàn phím (nhờ mainColumn
             tự co lại do windowSoftInputMode="adjustResize" + đây là view cuối cùng).
             Hiển thị đúng những gì app ĐÃ gửi lên TV (không lấy được nội dung thật
             trên TV vì HID không có chiều nhận ngược) — coi như "bản nháp đồng bộ".
             Gõ trực tiếp vào đây hoặc dán (paste) văn bản có dấu từ điện thoại đều
             được gửi lên TV ngay (tự chuyển Telex nếu cần). Tự xoá trắng khi
             di chuột/bấm chuột hoặc bấm Home, vì lúc đó ô nhập trên TV coi như
             đã đổi/mất focus, không còn đồng bộ với những gì hiển thị ở đây nữa. -->
        <LinearLayout
            android:id="@+id/syncInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2A2A2A"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/syncInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="16sp"
                android:hint="Đang gõ trên TV — có thể dán văn bản có dấu vào đây"
                android:inputType="text"
                android:importantForAutofill="no"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasteClipboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="20dp"
                android:backgroundTint="#40FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:text="📋"
                android:contentDescription="Dán văn bản từ điện thoại" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearSyncInput"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="20dp"
                android:backgroundTint="#40FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:text="✕"
                android:contentDescription="Xoá ô nhập (không xoá chữ đã gửi trên TV)" />

        </LinearLayout>

        <!-- Hiện thay cho trackpad/3 phím khi đang ở chế độ "bàn phím toàn màn hình" —
             lúc đó chỉ còn bàn phím ảo hệ thống là quan trọng, không cần chuột. -->
        <TextView
            android:id="@+id/keyboardModeHint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:background="#1B1B1B"
            android:textColor="#888888"
            android:textSize="16sp"
            android:text="Chế độ bàn phím toàn màn hình — gõ bình thường trên bàn phím ảo bên dưới. Bấm lại nút ⟳⌨ ở góc trên để tắt." />

    </LinearLayout>

    <!-- Nút nổi góc trên trái: bật/tắt DUY NHẤT chế độ "chuột toàn màn hình xoay ngang"
         (không liên quan tới bàn phím). Luôn nổi trên mọi lớp nên bấm tắt được ngay
         cả khi 3 phím điều hướng + thanh trạng thái đang bị ẩn tạm. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMouseFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="22dp"
        android:backgroundTint="#40000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="⟳🖱"
        android:contentDescription="Nhấn đúp để bật/tắt chế độ xoay ngang, phóng to chuột toàn màn hình" />

    <!-- Nút nổi góc trên phải: bật/tắt chế độ "bàn phím toàn màn hình xoay ngang"
         (không cần chuột). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeyboardFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="22dp"
        android:backgroundTint="#40000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="⟳⌨"
        android:contentDescription="Nhấn đúp để bật/tắt chế độ xoay ngang, bàn phím toàn màn hình" />

</FrameLayout>
