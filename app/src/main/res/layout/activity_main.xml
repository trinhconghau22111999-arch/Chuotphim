<?xml version="1.0" encoding="utf-8"?>
<!--
    Root là FrameLayout để chứa 2 lớp:
      - mainColumn: cột nội dung chính (trạng thái / trackpad / 3 phím), thứ tự
        của trackpad và controlsRow trong đây được MainActivity đổi chỗ tự động
        tuỳ theo bàn phím ảo đang ẩn hay hiện (xem applyLayoutState() trong code).
      - hiddenInput: ô nhập ẩn dùng để hứng bàn phím ảo hệ thống, đặt NGOÀI
        mainColumn và không bao giờ bị gỡ/gắn lại, để tránh mất focus gây
        vòng lặp ẩn/hiện bàn phím liên tục khi layout tự sắp xếp lại.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- topBar: khi CHƯA đăng ký HID thì ẩn statusText, hiện nút đăng ký để
             người dùng bấm; khi ĐÃ đăng ký thì đảo lại — chỉ 1 trong 2 hiện tại
             1 thời điểm (xem MainActivity: setHidRegisteredUi()). -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#212121">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:text="Chưa đăng ký HID"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterHid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAllCaps="false"
                android:text="Đăng ký làm bàn phím và chuột" />

        </FrameLayout>

        <!-- Trackpad: chiếm hết phần còn lại, diện tích tự co giãn theo
             vị trí của 3 phím và chiều cao bàn phím ảo. -->
        <com.example.btremote.TrackpadView
            android:id="@+id/trackpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444" />

        <!-- 3 phím điều khiển: cùng 1 style RemoteKeyButton => cùng kích cỡ,
             cùng chiều cao, canh lề đều nhau. -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1B1B1B"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDevice"
                style="@style/RemoteKeyButton"
                android:text="Chọn thiết bị" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyHome"
                style="@style/RemoteKeyButton"
                android:text="Home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenKeyboard"
                style="@style/RemoteKeyButton"
                android:text="⌨"
                android:textSize="22sp"
                android:contentDescription="Mở bàn phím để gõ chữ" />

        </LinearLayout>

        <!-- Hiện thay cho trackpad/3 phím khi đang ở chế độ "bàn phím toàn màn hình" —
             lúc đó chỉ còn bàn phím ảo hệ thống là quan trọng, không cần chuột. -->
        <TextView
            android:id="@+id/keyboardModeHint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:background="#1B1B1B"
            android:textColor="#888888"
            android:textSize="16sp"
            android:text="Chế độ bàn phím toàn màn hình — gõ bình thường trên bàn phím ảo bên dưới. Bấm lại nút ⟳⌨ ở góc trên để tắt." />

    </LinearLayout>

    <!-- Nút nổi góc trên trái: bật/tắt DUY NHẤT chế độ "chuột toàn màn hình xoay ngang"
         (không liên quan tới bàn phím). Luôn nổi trên mọi lớp nên bấm tắt được ngay
         cả khi 3 phím điều hướng + thanh trạng thái đang bị ẩn tạm. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMouseFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="22dp"
        android:backgroundTint="#40000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="⟳🖱"
        android:contentDescription="Bật/tắt chế độ xoay ngang, phóng to chuột toàn màn hình" />

    <!-- Nút nổi góc trên phải: bật/tắt chế độ "bàn phím toàn màn hình xoay ngang"
         (không cần chuột). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeyboardFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="22dp"
        android:backgroundTint="#40000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="⟳⌨"
        android:contentDescription="Bật/tắt chế độ xoay ngang, bàn phím toàn màn hình" />

    <EditText
        android:id="@+id/hiddenInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:importantForAutofill="no"
        android:inputType="text" />

</FrameLayout>
