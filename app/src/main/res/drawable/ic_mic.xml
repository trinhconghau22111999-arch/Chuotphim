<?xml version="1.0" encoding="utf-8"?>
<!-- Icon microphone dạng vector viền trắng, thay cho chữ "Mic" trước đây.
     Cùng phong cách outline với ic_mouse/ic_keyboard: thân mic hình viên
     nang đứng, phía dưới có giá đỡ dạng cung tròn hở + chân đế ngang, để
     nhận diện rõ là micro dù thu nhỏ trong nút tròn. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Thân mic: viên nang đứng -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9,5 A3,3 0 0,1 15,5 L15,11 A3,3 0 0,1 9,11 Z" />
    <!-- Giá đỡ: cung tròn hở ôm dưới thân mic -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M6,11 A6,6 0 0,0 18,11" />
    <!-- Cần đứng nối xuống chân đế -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M12,17 L12,20" />
    <!-- Chân đế ngang -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M8,20 L16,20" />
</vector>
